# ── Supabase (Project Settings → API) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is ONLY needed server-side for n8n webhook ingestion.
# Keep it out of any client bundle. Optional for interactive use.
SUPABASE_SERVICE_ROLE_KEY=

# ── Groq Cloud (console.groq.com → API Keys, starts with gsk_...) ────
GROQ_API_KEY=

# ── Webhook ingestion (n8n → app). Any long random string. ──────────
NEXUSCORE_WEBHOOK_SECRET=

# ── Optional: better embeddings. If unset, the app uses its built-in
# deterministic $0 hashed-bag-of-words embedding provider (1536-dim),
# which powers deal-memory search with keyword-level accuracy. ────────
# HF_TOKEN=            # optional: upgrades embeddings to BAAI/bge-small-en-v1.5 via Hugging Face (free tier). Falls back to the built-in deterministic 384-dim embedder when unset.
# OPENAI_API_KEY=

# ── Model overrides (defaults shown) ─────────────────────────────────
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3

# Public base URL used for auth redirects (defaults to window origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Attendee meeting bots (auto-capture) ─────────────────────────────────────
# attendee.dev API key (hosted: app.attendee.dev → API Keys; or self-hosted)
ATTENDEE_API_KEY=
# Base URL of the Attendee instance
ATTENDEE_BASE_URL=https://app.attendee.dev/api/v1
